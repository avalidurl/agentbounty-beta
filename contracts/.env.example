# AgentBounty contracts — environment template.
#
# AGENTS.md secrets policy (https://github.com/avalidurl/agentbounty/blob/main/AGENTS.md):
# - Real values live in ~/.config/agent-secrets/agentbounty/.env (chmod 600).
# - This file documents the shape only; it has placeholder values and is committed.
# - The contracts/.env sibling is gitignored and may either be empty or source
#   the global file via:
#       set -a && source ~/.config/agent-secrets/agentbounty/.env && set +a
#
# Before any forge command, source the global env:
#   set -a && source ~/.config/agent-secrets/agentbounty/.env && set +a
#   forge build
#   forge test
#   forge script script/Deploy.s.sol --rpc-url base_sepolia --account deployer \
#     --keystore-dir "$DEPLOYER_KEYSTORE_DIR" --broadcast --verify

# ---------- Block explorer ----------
BASESCAN_API_KEY=BASESCAN_API_KEY_PLACEHOLDER_34_CHARS_LONG

# ---------- RPC endpoints ----------
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ---------- Deployer wallet ----------
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_ACCOUNT_NAME=deployer
DEPLOYER_KEYSTORE_DIR=/Users/REPLACE_ME/.config/agent-secrets/agentbounty/keystores
